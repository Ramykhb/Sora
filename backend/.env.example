# Copy to .env, then replace every placeholder with a private value.
API_KEY=replace-with-a-long-random-key

POSTGRES_DB=visual_assistant
POSTGRES_USER=visual_assistant
POSTGRES_PASSWORD=replace-with-a-strong-password

S3_ACCESS_KEY=replace-with-an-access-key
S3_SECRET_KEY=replace-with-a-strong-secret

# Optional application settings
STORAGE_BACKEND=s3
S3_BUCKET=frames
VISION_MODEL=qwen2.5vl:3b
EMBEDDING_MODEL=qwen3-embedding:0.6b
FRAME_RETENTION_HOURS=24
CORS_ORIGINS=["http://localhost:8081","http://localhost:3000"]
ICE_SERVERS=[]
