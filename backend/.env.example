# Generate local secrets with: python3 backend/scripts/configure_local.py --host YOUR_LAN_IP
POSTGRES_DB=visual_assistant
POSTGRES_USER=sora
POSTGRES_PASSWORD=GENERATE_LOCAL_SECRET
DATABASE_URL=postgresql+asyncpg://sora:GENERATE_LOCAL_SECRET@localhost:5432/visual_assistant
S3_ACCESS_KEY=sora-local
S3_SECRET_KEY=GENERATE_LOCAL_SECRET
S3_BUCKET=frames
S3_ENDPOINT_URL=http://localhost:9000
STORAGE_BACKEND=s3
OLLAMA_URL=http://localhost:11434
VISION_MODEL=qwen2.5vl:3b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
VISION_IMAGE_MAX_SIDE=448
MODEL_THREADS=2
MODEL_TIMEOUT_SECONDS=120
YOLO_MODEL=models/yolo11n.pt
MODEL_DEVICE=cpu
DETECTOR_THREADS=2
DETECTION_IMAGE_SIZE=320
DETECTION_INTERVAL_SECONDS=0.25
DETECTION_MAX_AGE_SECONDS=2
SAMPLE_INTERVAL_SECONDS=1
LIVE_DEFER_ENRICHMENT=true
MAX_PENDING_ENRICHMENTS=2
RECENT_EVIDENCE_SECONDS=15
CURRENT_ANSWER_TIMEOUT_SECONDS=8
OCR_LANGUAGES=eng+fra+ara
OCR_MIN_WORD_CONFIDENCE=60
OCR_TIMEOUT_SECONDS=4
MAX_IMAGE_SIDE=1920
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
FRAME_RETENTION_HOURS=24
TURN_PUBLIC_HOST=127.0.0.1
TURN_INTERNAL_HOST=turn
TURN_SHARED_SECRET=GENERATE_LOCAL_SECRET
AUTH_REGISTRATION_ENABLED=true
AUTH_REQUIRE_VERIFIED_EMAIL=false
CORS_ORIGINS=["http://localhost:8081","http://localhost:5173","http://127.0.0.1:5173"]
