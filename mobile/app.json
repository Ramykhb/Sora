{
  "expo": {
    "name": "SORA",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Allow Sora to stream video to your local backend and dashboard."
      },
      "bitcode": false,
      "bundleIdentifier": "com.ramykhachab.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0703",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.ramykhachab.mobile"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sora to use your camera for live scene descriptions",
          "barcodeScannerEnabled": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF2E8",
          "image": "./assets/images/sora-ribbon.png",
          "imageWidth": 130,
          "dark": {
            "backgroundColor": "#0D0703",
            "image": "./assets/images/sora-ribbon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Sora to record your spoken questions",
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Sora to stream your camera for live assistance",
          "microphonePermission": "Allow Sora to record spoken questions"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SORA to describe images and read text from your photo library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SORA to listen for questions and Hey Sora app commands while the app is open.",
          "speechRecognitionPermission": "Allow SORA to recognize questions and Hey Sora commands so you can use the app hands-free."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
